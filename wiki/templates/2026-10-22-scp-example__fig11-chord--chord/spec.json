{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "linkage": {
      "interface": "render-cell-linkage",
      "description": "每个细胞每个维度一行的长表；dimension_order 决定两个维度的次序，category_levels 给出显式类别顺序；模板按原 StatPlot 的 table(useNA='ifany') 重建二维计数矩阵，不聚合输入。"
    }
  },
  "style": {
    "cell_col": "cell",
    "dimension_col": "dimension",
    "category_col": "category",
    "dimension_order_col": "dimension_order",
    "dimension_order": null,
    "category_levels": null,
    "palette": "Paired",
    "palcolor": null,
    "NA_color": "grey",
    "alpha": 1,
    "label": false,
    "legend": false,
    "transparency": 0.2,
    "link_lwd": 1,
    "link_lty": 1,
    "link_border": 1,
    "width_in": 8,
    "height_in": 6,
    "dpi": 150,
    "seed": 11,
    "sizing": {
      "mode": "adaptive",
      "base_in": 5.0,
      "per_sector_in": 0.35,
      "base_label_chars": 12,
      "per_label_char_in": 0.12,
      "min_width_in": 6.0,
      "min_height_in": 5.0,
      "aspect": 0.75,
      "max_width_in": null,
      "max_height_in": null
    }
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 等顶刊离散配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    },
    "font_size": {
      "type": "number",
      "label": "字号 (pt)",
      "default": 11.0,
      "min": 4.0,
      "max": 24.0,
      "step": 0.5
    },
    "transparency": {
      "type": "number",
      "label": "弦线透明度",
      "default": 0.2,
      "min": 0.1,
      "max": 0.95,
      "step": 0.05
    },
    "link_lwd": {
      "type": "number",
      "label": "弦线边框宽度",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0,
      "step": 0.2
    }
  }
}
