{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "membership": {
      "interface": "render-cell-membership",
      "description": "每个细胞 × 每个集合一行的 0/1 成员表，不聚合细胞；模板按原 StatPlot 的 upset 分支重建每个细胞的 intersection 列表并计数，集合顺序由 style.set_levels 显式给出"
    }
  },
  "style": {
    "cell_col": "cell",
    "set_col": "set",
    "member_col": "member",
    "set_levels": null,
    "stat_level": "TRUE",
    "label_size": 3.5,
    "label_fg": "black",
    "label_bg": "white",
    "label_bg_r": 0.1,
    "alpha": 1,
    "legend": false,
    "title": null,
    "subtitle": null,
    "xlab": "",
    "fill_palette": "material-indigo",
    "seed": 11,
    "width_in": 8,
    "height_in": 6,
    "dpi": 150,
    "sizing": {
      "mode": "adaptive",
      "base_in": 5.2,
      "per_intersection_in": 0.75,
      "per_set_in": 0.05,
      "base_label_chars": 6,
      "per_label_char_in": 0.12,
      "base_height_in": 3.6,
      "per_set_height_in": 0.6,
      "min_width_in": 5.0,
      "min_height_in": 4.0,
      "max_width_in": null,
      "max_height_in": null
    }
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 等顶刊离散配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    },
    "font_size": {
      "type": "number",
      "label": "字号 (pt)",
      "default": 3.5,
      "min": 4.0,
      "max": 24.0,
      "step": 0.5
    },
    "alpha": {
      "type": "number",
      "label": "条形透明度",
      "default": 1.0,
      "min": 0.1,
      "max": 1.0,
      "step": 0.05
    }
  }
}
