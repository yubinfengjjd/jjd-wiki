{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "easy_input": {
      "interface": "",
      "filename": "easy_input.csv",
      "description": "半小提琴箱线散点组合图输入数据表（easy_input.csv）",
      "required": true,
      "columns": {
        "est.ic50": {
          "type": "float",
          "description": "示例列 est.ic50",
          "required": true
        },
        "DNAmAge": {
          "type": "str",
          "description": "示例列 DNAmAge",
          "required": true
        }
      }
    },
    "easy_input_multi": {
      "interface": "",
      "filename": "easy_input_multi.csv",
      "description": "半小提琴箱线散点组合图输入数据表（easy_input_multi.csv）",
      "required": true,
      "columns": {
        "Enrichscore": {
          "type": "float",
          "description": "示例列 Enrichscore",
          "required": true
        },
        "TGFBcluster": {
          "type": "str",
          "description": "示例列 TGFBcluster",
          "required": true
        }
      }
    }
  },
  "style": {
    "dpi": 200,
    "width_in": 8.0,
    "height_in": 6.0,
    "palette": "NPG",
    "title": ""
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    }
  }
}
