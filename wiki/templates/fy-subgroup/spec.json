{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "easy_input": {
      "interface": "",
      "filename": "easy_input.csv",
      "description": "亚组生存风险森林图输入数据表（easy_input.csv）",
      "required": true,
      "columns": {
        "Patient_ID": {
          "type": "int",
          "description": "示例列 Patient_ID",
          "required": true
        },
        "ProjectID": {
          "type": "str",
          "description": "示例列 ProjectID",
          "required": true
        },
        "AJCC_stage": {
          "type": "int",
          "description": "示例列 AJCC_stage",
          "required": true
        },
        "OS_status": {
          "type": "int",
          "description": "示例列 OS_status",
          "required": true
        },
        "OS_time_months": {
          "type": "float",
          "description": "示例列 OS_time_months",
          "required": true
        },
        "score": {
          "type": "float",
          "description": "示例列 score",
          "required": true
        },
        "score_binary": {
          "type": "str",
          "description": "示例列 score_binary",
          "required": true
        }
      }
    },
    "subgroup": {
      "interface": "",
      "filename": "subgroup.csv",
      "description": "亚组生存风险森林图输入数据表（subgroup.csv）",
      "required": true,
      "columns": {}
    }
  },
  "style": {
    "dpi": 200,
    "width_in": 8.0,
    "height_in": 6.0,
    "palette": "NPG",
    "title": ""
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    }
  }
}
