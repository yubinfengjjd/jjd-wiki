{
  "entry": "code/render.py",
  "language": "python",
  "panel": "code/panel.py",
  "tables": {
    "SHAP逐样本值": {
      "description": "逐样本 SHAP 及特征值，每特征可有多个点；示例为固定种子合成近似，不代表真实样本量",
      "interface": "shap-samples"
    }
  },
  "style": {
    "font_family": "Arial",
    "dpi": 600,
    "shap_label": "SHAP Value",
    "font_weight": "bold",
    "axes_linewidth": 0.8,
    "hidden_spines": [
      "left",
      "top",
      "right"
    ],
    "width_in": 4.0,
    "height_in": 3.5,
    "rect": [
      0.29,
      0.11,
      0.6,
      0.86
    ],
    "xlim": null,
    "xticks": null,
    "clim": null,
    "feature_order": null,
    "cmap": "RdBu_r",
    "zero_line_color": "#999999",
    "feature_value_label": "Feature value",
    "high_label": "High",
    "low_label": "Low",
    "x_tick_direction": "in",
    "show_feature_labels": true,
    "major_tick_width": 0.8,
    "minor_tick_width": 0.6,
    "axis_offset_size": 7.5,
    "axis_tick_size": 7.0,
    "axis_label_size": 12.0,
    "colorbar_tick_size": 5.0,
    "colorbar_label_size": 6.0,
    "feature_label_size": 7.5,
    "zero_line_width": 1.0,
    "grid_line_width": 0.5
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 等顶刊离散配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 4.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 3.5,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    },
    "font_size": {
      "type": "number",
      "label": "字号 (pt)",
      "default": 12.0,
      "min": 4.0,
      "max": 24.0,
      "step": 0.5
    },
    "show_feature_labels": {
      "type": "boolean",
      "label": "显示特征名称",
      "default": true
    },
    "cmap": {
      "type": "select",
      "label": "特征值渐变色带",
      "default": "RdBu_r",
      "choices": [
        "RdBu_r",
        "viridis",
        "coolwarm",
        "Plasma"
      ]
    }
  }
}
