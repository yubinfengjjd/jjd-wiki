{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "easy_input": {
      "interface": "",
      "filename": "easy_input.csv",
      "description": "批量最佳切点生存曲线输入数据表（easy_input.csv）",
      "required": true,
      "columns": {}
    },
    "pvalue_output": {
      "interface": "",
      "filename": "pvalue_output.csv",
      "description": "批量最佳切点生存曲线输入数据表（pvalue_output.csv）",
      "required": true,
      "columns": {
        "ID": {
          "type": "str",
          "description": "示例列 ID",
          "required": true
        },
        "pvalue": {
          "type": "float",
          "description": "示例列 pvalue",
          "required": true
        },
        "HR": {
          "type": "float",
          "description": "示例列 HR",
          "required": true
        },
        "CIlow": {
          "type": "float",
          "description": "示例列 CIlow",
          "required": true
        },
        "CIup": {
          "type": "float",
          "description": "示例列 CIup",
          "required": true
        }
      }
    }
  },
  "style": {
    "dpi": 200,
    "width_in": 8.0,
    "height_in": 6.0,
    "palette": "NPG",
    "title": ""
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    }
  }
}
