{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "forest": {
      "interface": "subgroup-effect-table",
      "description": "按显示顺序排列的亚组标题行与亚组行；效应量与 CI 由上游给定"
    }
  },
  "style": {
    "xlog": true,
    "zero": 1,
    "xticks": [
      0.75,
      1.5
    ],
    "digits": 2,
    "label_header": "\nSubgroup",
    "n_header": "No. of\nPatients (%)",
    "estimate_header": "Hazard Ratio\n(95% CI)",
    "p_header": "P-value",
    "show_n": true,
    "show_p": true,
    "xlab": "     <-Favors A Arm      Favors B Arm->",
    "diamond": true,
    "box_col": "steelblue",
    "line_col": "black",
    "box_scale": 75,
    "box_size": 0.3,
    "overall_line": true,
    "graph_pos": 3,
    "graph_width_npc": 0.4,
    "line_height_cm": 0.75,
    "colgap_cm": 0.4,
    "cex": 1.25,
    "dpi": 200,
    "width_in": 12,
    "height_in": 12,
    "sizing": {
      "mode": "adaptive",
      "base_width_in": 6,
      "per_text_col_in": 1.8,
      "per_label_char_in": 0.1,
      "base_height_in": 2.2,
      "max_width_in": null,
      "max_height_in": null
    }
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 等顶刊离散配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 12.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 12.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    },
    "font_size": {
      "type": "number",
      "label": "字号 (pt)",
      "default": 11.0,
      "min": 4.0,
      "max": 24.0,
      "step": 0.5
    },
    "xlog": {
      "type": "boolean",
      "label": "对数 HR 横轴",
      "default": true
    },
    "show_n": {
      "type": "boolean",
      "label": "显示样本量 N",
      "default": true
    },
    "show_p": {
      "type": "boolean",
      "label": "显示检验 P 值",
      "default": true
    },
    "digits": {
      "type": "number",
      "label": "小数位数",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1
    }
  }
}
