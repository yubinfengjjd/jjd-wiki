{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "easy_input": {
      "interface": "",
      "filename": "easy_input.txt",
      "description": "分组临床分期扇形矩阵图输入数据表（easy_input.txt）",
      "required": true,
      "columns": {
        "SamID": {
          "type": "str",
          "description": "示例列 SamID",
          "required": true
        },
        "Risk": {
          "type": "str",
          "description": "示例列 Risk",
          "required": true
        },
        "Status": {
          "type": "str",
          "description": "示例列 Status",
          "required": true
        },
        "Stage": {
          "type": "str",
          "description": "示例列 Stage",
          "required": true
        },
        "M": {
          "type": "str",
          "description": "示例列 M",
          "required": true
        },
        "N": {
          "type": "str",
          "description": "示例列 N",
          "required": true
        },
        "T": {
          "type": "str",
          "description": "示例列 T",
          "required": true
        }
      }
    }
  },
  "style": {
    "dpi": 200,
    "width_in": 8.0,
    "height_in": 6.0,
    "palette": "NPG",
    "title": ""
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    }
  }
}
