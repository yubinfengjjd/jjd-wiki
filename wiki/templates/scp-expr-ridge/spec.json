{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "density": {
      "interface": "render-cell-feature-values",
      "description": "每个细胞每个 feature 一行的数值长表（cell, feature, value, group + 显式顺序列）；模板按原 CellDensityPlot 的 ggplot/ggridges 构造绘制分组密度脊线，不在模板内做特征提取、归一化或分组统计"
    }
  },
  "style": {
    "cell_col": "cell",
    "feature_col": "feature",
    "value_col": "value",
    "group_col": "group",
    "feature_order_col": "feature_order",
    "group_order_col": "group_order",
    "split_col": "split",
    "split_order_col": "split_order",
    "group_by": "SubCellType",
    "split_by": "All.groups",
    "feature_levels": null,
    "group_levels": null,
    "x_order": "value",
    "flip": false,
    "reverse": false,
    "decreasing": null,
    "palette": "Paired",
    "palcolor": null,
    "keep_empty": false,
    "y_nbreaks": 4,
    "y_min": null,
    "y_max": null,
    "aspect_ratio": null,
    "title": null,
    "subtitle": null,
    "legend_position": "right",
    "legend_direction": "vertical",
    "theme_use": "theme_scp",
    "theme_args": {},
    "combine": true,
    "nrow": null,
    "ncol": null,
    "byrow": true,
    "width_in": 8,
    "height_in": 6,
    "dpi": 150,
    "seed": 11,
    "sizing": {
      "mode": "adaptive",
      "base_in": 5.5,
      "per_feature_in": 3.5,
      "per_char_in": 0.09,
      "base_label_chars": 10,
      "min_width_in": 5.0,
      "base_height_in": 3.2,
      "per_group_in": 0.35,
      "min_height_in": 3.0,
      "max_width_in": null,
      "max_height_in": null
    }
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 等顶刊离散配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    },
    "font_size": {
      "type": "number",
      "label": "字号 (pt)",
      "default": 11.0,
      "min": 4.0,
      "max": 24.0,
      "step": 0.5
    },
    "flip": {
      "type": "boolean",
      "label": "反转坐标轴",
      "default": false
    },
    "ncol": {
      "type": "number",
      "label": "分面列数",
      "default": 2,
      "min": 1,
      "max": 6,
      "step": 1
    }
  }
}
