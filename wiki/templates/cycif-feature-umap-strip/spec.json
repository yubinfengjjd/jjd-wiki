{
  "entry": "code/render.py",
  "language": "python",
  "panel": "code/panel.py",
  "tables": {
    "cells": {
      "interface": "",
      "filename": "cycif_umap_markers.csv",
      "description": "单细胞 UMAP 坐标与多列归一化蛋白/基因强度宽表（cell_id, umap_1, umap_2 及多个标志物列）",
      "required": true,
      "columns": {
        "cell_id": {
          "type": "str",
          "description": "细胞唯一标识",
          "required": true
        },
        "umap_1": {
          "type": "float",
          "description": "UMAP 横坐标",
          "required": true
        },
        "umap_2": {
          "type": "float",
          "description": "UMAP 纵坐标",
          "required": true
        },
        "SOX10": {
          "type": "float",
          "description": "SOX10 归一化强度",
          "required": false
        },
        "CD11C": {
          "type": "float",
          "description": "CD11C 归一化强度",
          "required": false
        },
        "FOXP3": {
          "type": "float",
          "description": "FOXP3 归一化强度",
          "required": false
        },
        "CD8A": {
          "type": "float",
          "description": "CD8A 归一化强度",
          "required": false
        },
        "PDL1": {
          "type": "float",
          "description": "PDL1 归一化强度",
          "required": false
        },
        "PD1": {
          "type": "float",
          "description": "PD1 归一化强度",
          "required": false
        }
      }
    }
  },
  "style": {
    "header_title": "Marker intensities across all specimens",
    "point_size": 2.4,
    "alpha": 0.84,
    "dpi": 300,
    "width_in": 7.6,
    "height_in": 2.2,
    "rect": [
      0.03,
      0.08,
      0.92,
      0.72
    ]
  },
  "parameters": {
    "point_size": {
      "type": "number",
      "label": "散点大小",
      "default": 2.4,
      "min": 0.5,
      "max": 8.0,
      "step": 0.2
    },
    "alpha": {
      "type": "number",
      "label": "散点透明度",
      "default": 0.84,
      "min": 0.3,
      "max": 1.0,
      "step": 0.05
    }
  }
}
