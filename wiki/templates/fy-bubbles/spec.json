          "type": "float",
          "description": "示例列 zygote",
          "required": true
        },
        "early_2cell": {
          "type": "float",
          "description": "示例列 early_2cell",
          "required": true
        },
        "2cell": {
          "type": "float",
          "description": "示例列 2cell",
          "required": true
        },
        "4cell": {
          "type": "float",
          "description": "示例列 4cell",
          "required": true
        },
        "8cell": {
          "type": "float",
          "description": "示例列 8cell",
          "required": true
        },
        "ICM": {
          "type": "float",
          "description": "示例列 ICM",
          "required": true
        },
        "mESC": {
          "type": "float",
          "description": "示例列 mESC",
          "required": true
        }
