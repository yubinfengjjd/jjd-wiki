        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
