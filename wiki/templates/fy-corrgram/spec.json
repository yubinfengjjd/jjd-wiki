{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "easy_input": {
      "interface": "",
      "filename": "easy_input.csv",
      "description": "多变量相关矩阵散点热图输入数据表（easy_input.csv）",
      "required": true,
      "columns": {
        "sample": {
          "type": "str",
          "description": "示例列 sample",
          "required": true
        },
        "miR-450d": {
          "type": "float",
          "description": "示例列 miR-450d",
          "required": true
        },
        "BCL6": {
          "type": "float",
          "description": "示例列 BCL6",
          "required": true
        },
        "MYBL2": {
          "type": "float",
          "description": "示例列 MYBL2",
          "required": true
        },
        "PDK1": {
          "type": "float",
          "description": "示例列 PDK1",
          "required": true
        },
        "PDK2": {
          "type": "float",
          "description": "示例列 PDK2",
          "required": true
        },
        "PFKFB2": {
          "type": "float",
          "description": "示例列 PFKFB2",
          "required": true
        }
      }
    }
  },
  "style": {
    "dpi": 200,
    "width_in": 8.0,
    "height_in": 6.0,
    "palette": "NPG",
    "title": ""
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    }
  }
}
