{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "easy_input": {
      "interface": "",
      "filename": "easy_input.txt",
      "description": "富集分析对角排列气泡图输入数据表（easy_input.txt）",
      "required": true,
      "columns": {
        "Term": {
          "type": "str",
          "description": "示例列 Term",
          "required": true
        },
        "Count": {
          "type": "int",
          "description": "示例列 Count",
          "required": true
        },
        "Pop.Hits": {
          "type": "int",
          "description": "示例列 Pop.Hits",
          "required": true
        },
        "PValue": {
          "type": "float",
          "description": "示例列 PValue",
          "required": true
        }
      }
    }
  },
  "style": {
    "dpi": 200,
    "width_in": 8.0,
    "height_in": 6.0,
    "palette": "NPG",
    "title": ""
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    }
  }
}
