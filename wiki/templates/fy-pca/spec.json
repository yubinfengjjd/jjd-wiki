      "columns": {
        "bcr_patient_barcode": {
          "type": "str",
          "description": "示例列 bcr_patient_barcode",
          "required": true
        },
        "GATA3": {
          "type": "float",
          "description": "示例列 GATA3",
          "required": true
        },
        "PTEN": {
          "type": "float",
          "description": "示例列 PTEN",
          "required": true
        },
        "XBP1": {
          "type": "float",
          "description": "示例列 XBP1",
          "required": true
        },
        "ESR1": {
          "type": "float",
          "description": "示例列 ESR1",
          "required": true
        },
        "MUC1": {
          "type": "float",
          "description": "示例列 MUC1",
          "required": true
        }
      }
    },
    "easy_input_meta": {
      "interface": "",
      "filename": "easy_input_meta.csv",
      "description": "PCA降维置信椭圆图输入数据表（easy_input_meta.csv）",
      "required": true,
      "columns": {
        "bcr_patient_barcode": {
          "type": "str",
          "description": "示例列 bcr_patient_barcode",
          "required": true
        },
        "group": {
          "type": "str",
          "description": "示例列 group",
          "required": true
        }
      }
    }
