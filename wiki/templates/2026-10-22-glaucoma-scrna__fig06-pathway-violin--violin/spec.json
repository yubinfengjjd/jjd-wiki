{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "values": {
      "interface": "render-grouped-values",
      "description": "细胞级或样本级分组数值"
    },
    "summaries": {
      "interface": "render-group-summaries",
      "description": "预计算 mean/SD/p 标签和标注位置；模板不重算检验"
    }
  },
  "style": {
    "font_family": "sans",
    "dpi": 192,
    "width_in": 12,
    "height_in": 6.5,
    "seed": 11,
    "sizing": {
      "mode": "adaptive",
      "base_width_in": 5.0,
      "per_x_in": 0.75,
      "base_height_in": 6.5,
      "per_y_in": 0,
      "min_width_in": 6,
      "min_height_in": 5,
      "base_label_chars": 10,
      "per_label_char_in": 0.08,
      "aspect": 0.55,
      "max_width_in": null,
      "max_height_in": null
    },
    "celltype_levels": [
      "Muller_Glia",
      "Rod_Photoreceptor",
      "Bipolar",
      "Cone_Photoreceptor",
      "RGC_like",
      "RPE",
      "Vascular_Pericyte",
      "Amacrine",
      "Amacrine_Horizontal_like"
    ],
    "group_levels": [
      "Control",
      "Glaucoma"
    ],
    "color_scheme": [
      "#FF7F0E",
      "#1F77B4"
    ],
    "title": "Complement Pathway Score Comparison",
    "ylab": "Pathway Score",
    "dodge_width": 0.8,
    "violin_width": 0.7,
    "box_width": 0.18,
    "jitter_width": 0.18
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 等顶刊离散配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 12.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.5,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": "Complement Pathway Score Comparison"
    },
    "font_size": {
      "type": "number",
      "label": "字号 (pt)",
      "default": 11.0,
      "min": 4.0,
      "max": 24.0,
      "step": 0.5
    },
    "violin_width": {
      "type": "number",
      "label": "小提琴宽度",
      "default": 0.7,
      "min": 0.2,
      "max": 1.5,
      "step": 0.05
    },
    "box_width": {
      "type": "number",
      "label": "内嵌箱线宽度",
      "default": 0.18,
      "min": 0.05,
      "max": 0.6,
      "step": 0.02
    }
  }
}
