{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "de": {
      "interface": "bulk-de-table",
      "description": "一次两组比较的全部基因：log2FC 与原始 P 值（上游给定，不重算）"
    },
    "highlight": {
      "interface": "highlight-gene-sets",
      "description": "可选：要圈出并标注的基因及其基因集",
      "required": false
    }
  },
  "style": {
    "mode": "advanced",
    "logfc_cut": 1.5,
    "p_cut": 0.05,
    "logfc_cut2": 2.5,
    "p_cut2": 0.0001,
    "logfc_cut3": 5,
    "p_cut3": 1e-05,
    "x_limit": null,
    "set_colors": null,
    "missing_highlight": "error",
    "label_size": 5,
    "seed": 1,
    "base_size": 12,
    "title": "",
    "dpi": 200,
    "width_in": 6,
    "height_in": 5,
    "sizing": {
      "mode": "adaptive",
      "base_width_in": 6,
      "base_height_in": 5,
      "per_set_in": 0.25,
      "max_width_in": null,
      "max_height_in": null
    }
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 等顶刊离散配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 5.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    },
    "font_size": {
      "type": "number",
      "label": "字号 (pt)",
      "default": 12.0,
      "min": 4.0,
      "max": 24.0,
      "step": 0.5
    },
    "p_cutoff": {
      "type": "number",
      "label": "P 值显著性阈值",
      "default": 0.05,
      "min": 1e-05,
      "max": 0.2,
      "step": 0.005
    },
    "log2fc_cutoff": {
      "type": "number",
      "label": "|log2FC| 阈值",
      "default": 1.5,
      "min": 0.25,
      "max": 5.0,
      "step": 0.25
    }
  }
}
