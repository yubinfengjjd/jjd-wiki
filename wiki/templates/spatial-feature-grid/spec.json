{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "spots": {
      "interface": "",
      "filename": "spatial_spots_long.csv",
      "description": "空间转录组 Spot 坐标与特征/基因强度长表（x、y、feature、value、可选 sample）",
      "required": true,
      "columns": {
        "x": {
          "type": "float",
          "description": "组织切片 Spot 横坐标（如 imagecol）",
          "required": true
        },
        "y": {
          "type": "float",
          "description": "组织切片 Spot 纵坐标（如 imagerow，渲染时按显微图像习惯倒置或正置）",
          "required": true
        },
        "feature": {
          "type": "str",
          "description": "展示的细胞类型分数、签名密度或基因名",
          "required": true
        },
        "value": {
          "type": "float",
          "description": "对应 Spot 的表达值或反卷积/签名强度",
          "required": true
        },
        "sample": {
          "type": "str",
          "description": "可选样本切片标识（多切片分面时使用）",
          "required": false
        }
      }
    }
  },
  "style": {
    "ncol": 4,
    "point_size": 0.9,
    "point_alpha": 0.95,
    "palette": "spectral",
    "invert_y": true,
    "dpi": 300,
    "width_in": 9.6,
    "height_in": 3.0
  },
  "parameters": {
    "ncol": {
      "type": "number",
      "label": "分面列数",
      "default": 4,
      "min": 1,
      "max": 8,
      "step": 1
    },
    "point_size": {
      "type": "number",
      "label": "Spot 散点大小",
      "default": 0.9,
      "min": 0.2,
      "max": 3.0,
      "step": 0.1
    },
    "palette": {
      "type": "select",
      "label": "色标方案",
      "default": "spectral",
      "options": ["spectral", "viridis", "bwr"]
    }
  }
}
