{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "de": {
      "interface": "render-de-results",
      "description": "单个比较组的 DE 结果；group1 必须唯一，pct_1/pct_2 为 0–1 阳性细胞比例，p_val_adj 必须 > 0"
    }
  },
  "style": {
    "group_col": "group1",
    "group": null,
    "columns": null,
    "x_metric": "diff_pct",
    "de_threshold": "avg_log2FC > 0 & p_val_adj < 0.05",
    "palette": "RdBu",
    "palcolor": null,
    "pt_size": 1,
    "pt_alpha": 1,
    "cols_highlight": "black",
    "sizes_highlight": 1,
    "alpha_highlight": 1,
    "stroke_highlight": 0.5,
    "nlabel": 8,
    "features_label": null,
    "label_fg": "black",
    "label_bg": "white",
    "label_bg_r": 0.1,
    "label_size": 4,
    "xlab": null,
    "ylab": "-log10(p-adjust)",
    "aspect_ratio": null,
    "seed": 1,
    "dpi": 200,
    "width_in": 7,
    "height_in": 6,
    "sizing": {
      "mode": "adaptive",
      "base_width_in": 7,
      "base_height_in": 6,
      "base_label_chars": 8,
      "per_label_char_in": 0.12,
      "base_labels": 16,
      "per_label_in": 0.1,
      "max_width_in": null,
      "max_height_in": null
    }
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 等顶刊离散配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 7.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    },
    "font_size": {
      "type": "number",
      "label": "字号 (pt)",
      "default": 4.0,
      "min": 4.0,
      "max": 24.0,
      "step": 0.5
    },
    "p_cutoff": {
      "type": "number",
      "label": "校正 P 值阈值 (padj)",
      "default": 0.05,
      "min": 0.0001,
      "max": 0.2,
      "step": 0.005
    },
    "log2fc_cutoff": {
      "type": "number",
      "label": "|log2FC| 阈值",
      "default": 1.0,
      "min": 0.25,
      "max": 5.0,
      "step": 0.25
    },
    "nlabel": {
      "type": "number",
      "label": "标注 Top 基因数",
      "default": 8,
      "min": 0,
      "max": 30,
      "step": 1
    },
    "pt_size": {
      "type": "number",
      "label": "散点大小",
      "default": 1.0,
      "min": 0.2,
      "max": 5.0,
      "step": 0.2
    }
  }
}
