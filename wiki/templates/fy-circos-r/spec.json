{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "gene_feature": {
      "interface": "",
      "filename": "Gene_feature.txt",
      "description": "分组环形连线关系图输入数据表（Gene_feature.txt）",
      "required": true,
      "columns": {
        "GeneID": {
          "type": "str",
          "description": "示例列 GeneID",
          "required": true
        },
        "Subgroup": {
          "type": "str",
          "description": "示例列 Subgroup",
          "required": true
        },
        "Feature_Start": {
          "type": "int",
          "description": "示例列 Feature_Start",
          "required": true
        },
        "Feature_End": {
          "type": "int",
          "description": "示例列 Feature_End",
          "required": true
        },
        "bar_col": {
          "type": "str",
          "description": "示例列 bar_col",
          "required": true
        }
      }
    },
    "gene_id": {
      "interface": "",
      "filename": "Gene_ID.txt",
      "description": "分组环形连线关系图输入数据表（Gene_ID.txt）",
      "required": true,
      "columns": {
        "GeneID": {
          "type": "str",
          "description": "示例列 GeneID",
          "required": true
        },
        "Gene_Start": {
          "type": "int",
          "description": "示例列 Gene_Start",
          "required": true
        },
        "Gene_End": {
          "type": "int",
          "description": "示例列 Gene_End",
          "required": true
        }
      }
    },
    "links": {
      "interface": "",
      "filename": "Links.txt",
      "description": "分组环形连线关系图输入数据表（Links.txt）",
      "required": true,
      "columns": {
        "Gene_1": {
          "type": "str",
          "description": "示例列 Gene_1",
          "required": true
        },
        "Point_1": {
          "type": "float",
          "description": "示例列 Point_1",
          "required": true
        },
        "Gene_2": {
          "type": "str",
          "description": "示例列 Gene_2",
          "required": true
        },
        "Point_2": {
          "type": "float",
          "description": "示例列 Point_2",
          "required": true
        },
        "link_col": {
          "type": "str",
          "description": "示例列 link_col",
          "required": true
        },
        "link_height": {
          "type": "float",
          "description": "示例列 link_height",
          "required": true
        }
      }
    }
  },
  "style": {
    "dpi": 200,
    "width_in": 8.0,
    "height_in": 6.0,
    "palette": "NPG",
    "title": ""
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    }
  }
}
