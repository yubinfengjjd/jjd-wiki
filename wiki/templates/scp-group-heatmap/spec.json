{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "heatmap": {
      "interface": "render-group-heatmap",
      "description": "一个 matrix × feature × group 的长表；模板按 matrix 重建多个热图矩阵"
    }
  },
  "style": {
    "exp_method": "zscore",
    "exp_legend_title": "zscore(normalized counts)",
    "heatmap_palette": "RdBu",
    "heatmap_palcolor": null,
    "group_palette": "Paired",
    "group_palcolor": null,
    "nlabel": 20,
    "features_label": null,
    "label_size": 10,
    "label_color": "black",
    "flip": false,
    "dpi": 150,
    "width_in": 8,
    "height_in": 6,
    "seed": 11,
    "sizing": {
      "mode": "adaptive",
      "base_width_in": 3,
      "per_x_in": 0.35,
      "base_height_in": 2,
      "per_y_in": 0.25,
      "min_width_in": 6,
      "min_height_in": 5,
      "base_label_chars": 8,
      "per_label_char_in": 0.08,
      "aspect": null,
      "max_width_in": null,
      "max_height_in": null
    }
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 等顶刊离散配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 8.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    },
    "font_size": {
      "type": "number",
      "label": "字号 (pt)",
      "default": 10.0,
      "min": 4.0,
      "max": 24.0,
      "step": 0.5
    },
    "nlabel": {
      "type": "number",
      "label": "高亮标注基因数",
      "default": 20,
      "min": 0,
      "max": 60,
      "step": 5
    },
    "flip": {
      "type": "boolean",
      "label": "转置矩阵方向",
      "default": false
    }
  }
}
