{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "surv": {
      "interface": "survival-time-event-group",
      "description": "每行一个个体：随访时间、事件（0/1）与分组；组数任意（≥2）"
    }
  },
  "style": {
    "levels": [
      "high",
      "med",
      "low"
    ],
    "labels": [
      "High-expression",
      "Med-expression",
      "Low-expression"
    ],
    "palette": [
      "red",
      "navy",
      "darkgreen"
    ],
    "pval": true,
    "conf_int": true,
    "conf_int_alpha": 0.1,
    "risk_table": true,
    "tables_height": 0.3,
    "linetype": "solid",
    "legend_title": "",
    "legend_pos": [
      0.8,
      0.9
    ],
    "xlab": "Months",
    "ylab": "Survival probability",
    "dpi": 200,
    "width_in": 7,
    "height_in": 6,
    "sizing": {
      "mode": "adaptive",
      "base_width_in": 7,
      "base_height_in": 6,
      "per_group_in": 0.25,
      "base_label_chars": 16,
      "per_label_char_in": 0.06,
      "max_width_in": null,
      "max_height_in": null
    }
  },
  "parameters": {
    "palette": {
      "type": "select",
      "label": "顶刊配色主题 (ggsci)",
      "default": "NPG",
      "choices": [
        "NPG",
        "Nature",
        "Lancet",
        "NEJM",
        "JAMA",
        "Cell"
      ],
      "description": "选择 Nature/Lancet/NEJM/JAMA/Cell 等顶刊离散配色方案"
    },
    "width": {
      "type": "number",
      "label": "画布宽度 (inch)",
      "default": 7.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "height": {
      "type": "number",
      "label": "画布高度 (inch)",
      "default": 6.0,
      "min": 3.0,
      "max": 20.0,
      "step": 0.5
    },
    "title": {
      "type": "string",
      "label": "图标题",
      "default": ""
    },
    "font_size": {
      "type": "number",
      "label": "字号 (pt)",
      "default": 11.0,
      "min": 4.0,
      "max": 24.0,
      "step": 0.5
    },
    "pval": {
      "type": "boolean",
      "label": "显示 Log-rank P 值",
      "default": true
    },
    "conf_int": {
      "type": "boolean",
      "label": "显示 95% 置信区间",
      "default": true
    },
    "risk_table": {
      "type": "boolean",
      "label": "显示风险表 (Risk Table)",
      "default": true
    }
  }
}
