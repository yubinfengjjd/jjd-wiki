{
  "entry": "code/render.py",
  "language": "python",
  "panel": "code/panel.py",
  "tables": {
    "positivity": {
      "interface": "",
      "filename": "cluster_marker_positivity.csv",
      "description": "各细胞亚群在多个标志物上的阳性百分比宽表（TCC 及各标志物阳性率 0-100 列）",
      "required": true,
      "columns": {
        "TCC": {
          "type": "str",
          "description": "细胞亚群或空间簇名称（如 TCC1..TCC10）",
          "required": true
        },
        "S100a": {
          "type": "float",
          "description": "S100A+ 阳性细胞百分比",
          "required": false
        },
        "MART1": {
          "type": "float",
          "description": "MART1+ 阳性细胞百分比",
          "required": false
        },
        "CCND1": {
          "type": "float",
          "description": "CCND1+ 阳性细胞百分比",
          "required": false
        },
        "MYC": {
          "type": "float",
          "description": "MYC+ 阳性细胞百分比",
          "required": false
        },
        "HLADPB1": {
          "type": "float",
          "description": "HLA-II+ 阳性细胞百分比",
          "required": false
        }
      }
    }
  },
  "style": {
    "xlabel": "Fraction of cells",
    "ylabel": "TCCs",
    "bar_height": 0.76,
    "dpi": 300,
    "width_in": 4.2,
    "height_in": 3.4,
    "rect": [
      0.14,
      0.14,
      0.82,
      0.74
    ]
  },
  "parameters": {
    "bar_height": {
      "type": "number",
      "label": "水平条高度",
      "default": 0.76,
      "min": 0.3,
      "max": 0.95,
      "step": 0.05
    }
  }
}
