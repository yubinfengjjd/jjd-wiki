  "logical_panel": "A",
  "chart_type": "chord",
  "input": "data/render-cell-linkage.csv",
  "aggregated_input": "data/chord-count-matrix.csv",
  "input_columns": {
    "cell": "cell identifier; one row per cell per dimension",
    "dimension": "annotation/dimension name (CellType, Phase)",
    "category": "category value of that dimension for the cell",
    "dimension_order": "1-based dimension order; 1 = first chord sector group"
  },
  "params": {
    "plot_type": "chord",
    "stat_by": [
      "CellType",
      "Phase"
    ],
    "stat_type": "count",
    "category_levels": {
      "CellType": [
        "Ductal",
        "Ngn3 low EP",
        "Ngn3 high EP",
        "Pre-endocrine",
        "Endocrine"
      ],
      "Phase": [
        "G1",
        "S",
        "G2M"
      ]
    },
    "palette": "Paired",
    "palcolor": null,
    "NA_color": "grey",
    "transparency": 0.2,
    "link_lwd": 1,
    "link_lty": 1,
    "link_border": 1,
    "width_in": 8,
    "height_in": 6,
    "dpi": 150,
    "seed": 11,
    "device_png": "grDevices::png(width=1200, height=900, res=150, bg=\"white\"); grDevices::replayPlot(p)",
    "device_pdf": "grDevices::cairo_pdf(width=8, height=6, bg=\"white\"); grDevices::replayPlot(p)",
    "device_svg": "svglite::svglite(width=8, height=6, bg=\"white\"); grDevices::replayPlot(p)"
  },
  "provenance": {
    "data": "pancreas_sub example, 1000 cells; CellType and Phase read from @meta.data; counts via base table(useNA='ifany')",
