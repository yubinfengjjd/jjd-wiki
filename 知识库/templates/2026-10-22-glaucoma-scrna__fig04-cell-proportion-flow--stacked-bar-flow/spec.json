{
  "entry": "code/render.R",
  "language": "r",
  "tables": {
    "proportions": {
      "interface": "render-cell-proportions",
      "description": "每组细胞类型比例；每组应归一化到 1"
    }
  },
  "style": {
    "font_family": "sans",
    "dpi": 192,
    "width_in": 5.5,
    "height_in": 4.5,
    "sizing": {
      "mode": "adaptive",
      "base_width_in": 4.0,
      "per_x_in": 0.45,
      "base_height_in": 3.5,
      "per_y_in": 0,
      "min_width_in": 5.5,
      "min_height_in": 4.5,
      "base_label_chars": 10,
      "per_label_char_in": 0.08,
      "aspect": 0.8,
      "max_width_in": null,
      "max_height_in": null
    },
    "x_levels": ["Control", "Glaucoma"],
    "stack_levels": [
      "Muller_Glia", "Rod_Photoreceptor", "Bipolar", "Cone_Photoreceptor",
      "RGC_like", "RPE", "Vascular_Pericyte", "Amacrine", "Amacrine_Horizontal_like"
    ],
    "legend_levels": [
      "Amacrine_Horizontal_like", "Amacrine", "Vascular_Pericyte", "RPE",
      "RGC_like", "Cone_Photoreceptor", "Bipolar", "Rod_Photoreceptor", "Muller_Glia"
    ],
    "palette": ["#E64B35", "#4DBBD5", "#00A087", "#3C5488", "#F39B7F", "#8491B4", "#91D1C2", "#DC0000", "#7E6148"],
    "normalize": true,
    "bar_width": 0.36,
    "flow_alpha": 0.22,
    "bar_alpha": 0.92,
    "flow_n": 120,
    "y_lab": "Cell proportion",
    "legend_title": "Cell type"
  }
}
