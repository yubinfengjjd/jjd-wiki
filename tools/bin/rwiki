#!/bin/sh
# rwiki: research-wiki command entry for Git Bash (Claude Code on Windows runs Git Bash).
# Use the same machine config and dedicated interpreter discovery as rwiki.cmd.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$script_dir/../machine-paths.ps1")" "$@"
