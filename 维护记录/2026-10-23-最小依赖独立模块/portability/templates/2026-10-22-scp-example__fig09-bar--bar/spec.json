      "per_stat_in": 0.25,
      "base_height_in": 4.6,
      "min_width_in": 6.0,
      "min_height_in": 3.5,
      "base_label_chars": 14,
      "per_label_char_in": 0.1,
      "aspect": 0.75,
      "max_width_in": null,
      "max_height_in": null
    }
  }
